      <true/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>
    <!-- The area's name the person saves on Plan Ease's day-starts card, typed or filled in by
         "Use my location". It is coarse location either way, which was already true of a typed
         area. NOT PreciseLocation: the phone asks for approximate, a kilometre is all the fix
         is worth, and nothing precise is ever stored or sent. -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeCoarseLocation</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <true/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>
    <!-- Apple Health, read only, for a fitness bot the person made and switched on: daily step
         totals and workouts (kind and minutes), kept 31 days and deleted when the switch goes
         off. Nothing else is read, nothing is written, and none of it is ever used for ads or
         sent to an AI service. Both rows come out again if iPhone health is cut. -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeHealth</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <true/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
