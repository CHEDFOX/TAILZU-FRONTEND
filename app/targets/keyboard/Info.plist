<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDisplayName</key>
  <string>Tailzu</string>
  <!-- Required so the keyboard can record voice for dictation (Full Access). -->
  <key>NSMicrophoneUsageDescription</key>
  <string>Tailzu uses the microphone to turn your speech into clean text.</string>
  <key>NSExtension</key>
  <dict>
    <key>NSExtensionAttributes</key>
    <dict>
      <!-- MUST be true: iOS only offers a custom keyboard in fields that
           request ASCII-capable input (search bars incl. Spotlight/app
           search, URL and email fields) when the keyboard declares it can
           type ASCII. Ours is a full QWERTY — declaring false made Tailzu
           vanish from the selector in exactly those places. -->
      <key>IsASCIICapable</key>
      <true/>
      <key>PrefersRightToLeft</key>
      <false/>
      <key>PrimaryLanguage</key>
      <string>en-US</string>
      <!-- Required so the keyboard can reach the Tulmi backend for Refine. -->
      <key>RequestsOpenAccess</key>
      <true/>
    </dict>
    <key>NSExtensionPointIdentifier</key>
    <string>com.apple.keyboard-service</string>
    <key>NSExtensionPrincipalClass</key>
    <string>$(PRODUCT_MODULE_NAME).KeyboardViewController</string>
  </dict>
</dict>
</plist>
