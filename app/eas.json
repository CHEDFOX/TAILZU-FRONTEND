{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "android": { "buildType": "apk" },
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "SENTRY_ALLOW_FAILURE": "true",
        "TULMI_ANDROID_HEALTH": "off",
        "TULMI_ANDROID_HEALTH_SLEEP": "off",
        "TULMI_ANDROID_CALENDAR": "off",
        "TULMI_ANDROID_MOTION": "off",
        "TULMI_ANDROID_ARRIVAL": "off"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": { "buildType": "apk" },
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "SENTRY_ALLOW_FAILURE": "true",
        "TULMI_ANDROID_HEALTH": "off",
        "TULMI_ANDROID_HEALTH_SLEEP": "off",
        "TULMI_ANDROID_CALENDAR": "off",
        "TULMI_ANDROID_MOTION": "off",
        "TULMI_ANDROID_ARRIVAL": "off"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "environment": "production",
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "SENTRY_ALLOW_FAILURE": "true",
        "TULMI_ANDROID_HEALTH": "off",
        "TULMI_ANDROID_HEALTH_SLEEP": "off",
        "TULMI_ANDROID_CALENDAR": "off",
        "TULMI_ANDROID_MOTION": "off",
        "TULMI_ANDROID_ARRIVAL": "off"
      }
    },
    "n0": {
      "extends": "production",
      "channel": "n0",
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "SENTRY_ALLOW_FAILURE": "true",
        "TULMI_ANDROID_HEALTH": "on",
        "TULMI_ANDROID_HEALTH_SLEEP": "on",
        "TULMI_ANDROID_CALENDAR": "on",
        "TULMI_ANDROID_MOTION": "on",
        "TULMI_ANDROID_ARRIVAL": "on"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6784811357",
        "appleTeamId": "6552H8HYA4"
      }
    }
  }
}
