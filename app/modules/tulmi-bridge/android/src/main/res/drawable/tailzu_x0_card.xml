<?xml version="1.0" encoding="utf-8"?>
<!--
  The X0 widget's card (the question, the job, the finished thing on the 4x4): an outline in the line grey with the inner 16dp
  rounding, open inside so the ground shows; tinted at run time.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="1dp"
        android:color="@color/tailzu_widget_line" />
    <corners android:radius="16dp" />
</shape>
