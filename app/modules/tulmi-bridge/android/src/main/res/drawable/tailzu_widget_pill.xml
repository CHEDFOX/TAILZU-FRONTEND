<?xml version="1.0" encoding="utf-8"?>
<!--
  A quick-access widget's button: a white pill the widget tints to the
  server's style (widgets.look.styles: primary, secondary, destructive) at run
  time, under the button's words.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FFFFFFFF" />
    <corners android:radius="14dp" />
</shape>
