<?xml version="1.0" encoding="utf-8"?>
<!--
  A button's fill: a white pill, fully rounded (a radius past half the height
  draws a capsule), that the widget tints to the server's style at run time
  (widgets.look.styles / lightStyles: primary, secondary, destructive). Its
  border is tailzu_widget_pill_ring, over it.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FFFFFFFF" />
    <corners android:radius="100dp" />
</shape>
