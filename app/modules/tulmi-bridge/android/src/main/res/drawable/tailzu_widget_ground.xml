<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget's card: the theme's ground (white, or the dark ink at night), so
  a widget follows the phone's light or dark theme before the first draw and
  whenever the server sends no colours. A widget tints it to the server's
  ground at run time. Launchers before Android 12 do not round widgets, so it
  rounds itself.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/tailzu_widget_ground" />
    <corners android:radius="20dp" />
</shape>
