<?xml version="1.0" encoding="utf-8"?>
<!--
  THE MARK: Blip's head, X0's own (the small solid glyph, no dots, so it
  stays crisp at icon sizes: tailzu_widget_mark_art). His malt face and dark
  outline read on both the light and the dark ground, so one drawable serves
  both themes. 60dp square at rest (an ImageView scales it), the head padded
  inside, so it never stretches.

  Never tinted: a widget leaves the colour filter off any drawable whose name
  starts with tailzu_widget_mark. The server names it per section and per bot
  row (widgets.look: androidIcon "tailzu_widget_mark").
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@android:color/transparent" />
            <size
                android:width="60dp"
                android:height="60dp" />
        </shape>
    </item>
    <item android:drawable="@drawable/tailzu_widget_mark_art" />
</layer-list>
