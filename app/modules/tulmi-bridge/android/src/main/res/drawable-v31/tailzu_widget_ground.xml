<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget's card on Android 12+: the launcher clips every widget to the
  system's corner radius, so the card uses the same one and the two edges
  agree. The theme's ground, as before Android 12.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/tailzu_widget_ground" />
    <corners android:radius="@android:dimen/system_app_widget_background_radius" />
</shape>
