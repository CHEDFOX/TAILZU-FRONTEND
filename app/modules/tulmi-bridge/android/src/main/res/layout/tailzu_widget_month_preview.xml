<?xml version="1.0" encoding="utf-8"?>
<!--
  What the widget picker shows on Android 12+ before the widget is placed: the
  mark, and the iOS gallery's sample month (318 words left, the line at 742 of
  1,060) in the theme's ink. Theme colours, because the picker cannot read
  what the app wrote; they follow the phone's light or dark theme. Text sizes
  are dp, as the face's are.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tailzu_widget_ground">

    <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="14dp"
        android:layout_marginTop="14dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:src="@drawable/tailzu_widget_mark" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="bottom|start"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false"
            android:letterSpacing="-0.02"
            android:maxLines="1"
            android:text="@string/tailzu_widget_month_preview_number"
            android:textColor="@color/tailzu_widget_ink"
            android:textSize="34dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:text="@string/tailzu_widget_month_preview_label"
            android:textColor="@color/tailzu_widget_meta"
            android:textSize="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/tailzu_widget_preview_track"
            android:orientation="horizontal"
            android:weightSum="1">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.7"
                android:background="@drawable/tailzu_widget_preview_fill" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
