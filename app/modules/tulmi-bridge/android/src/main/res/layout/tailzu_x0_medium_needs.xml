<?xml version="1.0" encoding="utf-8"?>
<!--
  THE X0 WIDGET (TailzuX0Widget.kt), 4x2, something needs you: the bot's big face (and what it is doing, when it is also at
  work); NEEDS YOU and the bot; the question; the answers in a row and You decide, or how a pressed one went.

  Generated with the other tailzu_x0_* layouts from one spec (android/x0-layouts.py), so a pill, a tile or a face is the same
  block everywhere. Every word, colour, face and tap is set at run time from the glance the app wrote (x0.glance); what is here
  is the theme's, for the moment before the first draw. RemoteViews-safe views only. The root carries @android:id/background:
  Android 12+ rounds the widget on it and animates a tap from it.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/tailzu_x0_ground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/tailzu_widget_ground" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="top"
        android:orientation="horizontal"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/tailzu_x0_face"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/tailzu_x0_head_tailzu" />

            <LinearLayout
                android:id="@+id/tailzu_x0_lead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="top"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/tailzu_x0_lead_dot"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/tailzu_x0_dot" />

                <TextView
                    android:id="@+id/tailzu_x0_lead_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:textColor="@color/tailzu_widget_meta"
                    android:textSize="10.5dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/tailzu_x0_dot"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/tailzu_x0_dot" />

                <TextView
                    android:id="@+id/tailzu_x0_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.04"
                    android:maxLines="1"
                    android:textColor="@color/tailzu_widget_ink"
                    android:textSize="11dp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tailzu_x0_question"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:lineSpacingExtra="2dp"
                android:maxLines="3"
                android:textColor="@color/tailzu_widget_ink"
                android:textSize="16dp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/tailzu_x0_pills"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/tailzu_x0_p0"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="6dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/tailzu_x0_p0_bg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:src="@drawable/tailzu_widget_pill" />

                    <ImageView
                        android:id="@+id/tailzu_x0_p0_ring"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:src="@drawable/tailzu_widget_pill_ring" />

                    <TextView
                        android:id="@+id/tailzu_x0_p0_text"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:paddingEnd="16dp"
                        android:paddingStart="16dp"
                        android:textColor="@color/tailzu_widget_ground"
                        android:textSize="13dp" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/tailzu_x0_p1"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="6dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/tailzu_x0_p1_bg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:src="@drawable/tailzu_widget_pill" />

                    <ImageView
                        android:id="@+id/tailzu_x0_p1_ring"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:src="@drawable/tailzu_widget_pill_ring" />

                    <TextView
                        android:id="@+id/tailzu_x0_p1_text"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:paddingEnd="16dp"
                        android:paddingStart="16dp"
                        android:textColor="@color/tailzu_widget_ground"
                        android:textSize="13dp" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/tailzu_x0_p2"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="6dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/tailzu_x0_p2_bg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:src="@drawable/tailzu_widget_pill" />

                    <ImageView
                        android:id="@+id/tailzu_x0_p2_ring"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:src="@drawable/tailzu_widget_pill_ring" />

                    <TextView
                        android:id="@+id/tailzu_x0_p2_text"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:paddingEnd="16dp"
                        android:paddingStart="16dp"
                        android:textColor="@color/tailzu_widget_ground"
                        android:textSize="13dp" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tailzu_x0_decide"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:paddingEnd="4dp"
                    android:paddingStart="4dp"
                    android:textColor="@color/tailzu_widget_meta"
                    android:textSize="13dp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/tailzu_x0_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/tailzu_widget_meta"
                android:textSize="13dp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
