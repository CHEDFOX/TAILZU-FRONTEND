<?xml version="1.0" encoding="utf-8"?>
<!--
  THE X0 WIDGET (TailzuX0Widget.kt), 4x2, all quiet: the greeting, the day's line, Ask any bot with the peek-bot key; the X0
  bot hanging on at the top. Also the widget as placed, before the first draw.

  Generated with the other tailzu_x0_* layouts from one spec (android/x0-layouts.py), so a pill, a tile or a face is the same
  block everywhere. Every word, colour, face and tap is set at run time from the glance the app wrote (x0.glance); what is here
  is the theme's, for the moment before the first draw. RemoteViews-safe views only. The root carries @android:id/background:
  Android 12+ rounds the widget on it and animates a tap from it.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/tailzu_x0_ground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/tailzu_widget_ground" />

    <ImageView
        android:id="@+id/tailzu_x0_hang"
        android:layout_width="112dp"
        android:layout_height="67dp"
        android:layout_gravity="top|end"
        android:layout_marginEnd="20dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitStart"
        android:src="@drawable/tailzu_x0_hang" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tailzu_x0_hello"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="116dp"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/tailzu_widget_meta"
            android:textSize="13dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tailzu_x0_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="116dp"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:lineSpacingExtra="1dp"
            android:maxLines="2"
            android:textColor="@color/tailzu_widget_ink"
            android:textSize="20dp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <FrameLayout
            android:id="@+id/tailzu_x0_ask"
            android:layout_width="match_parent"
            android:layout_height="44dp">

            <ImageView
                android:id="@+id/tailzu_x0_ask_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/tailzu_widget_pill" />

            <ImageView
                android:id="@+id/tailzu_x0_ask_ring"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/tailzu_widget_pill_ring" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingEnd="4dp"
                android:paddingStart="18dp">

                <TextView
                    android:id="@+id/tailzu_x0_ask_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/tailzu_x0_ask"
                    android:textColor="@color/tailzu_widget_meta"
                    android:textSize="14dp" />

                <ImageView
                    android:id="@+id/tailzu_x0_ask_key"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/tailzu_x0_peek" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
