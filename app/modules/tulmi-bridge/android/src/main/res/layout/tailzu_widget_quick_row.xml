<?xml version="1.0" encoding="utf-8"?>
<!--
  One row of a quick-access widget (TailzuQuickWidgets.kt), added to the
  widget's column once per row: a hairline above it (not above the first);
  the avatar (a surface-grey disc with the person's initial, or the row's
  mark; a bot's row rings it in that bot's own colour); who, a short tag,
  when, what; under it either how a pressed button went, or up to three
  buttons (capsules: a fill and a 1dp ring under the words, each tinted to
  the server's style at run time, so every Android version draws them).
  Tapping the words opens the row's own link; each button its own.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/tailzu_row_rule"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="38dp"
        android:background="@color/tailzu_widget_line" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <FrameLayout
            android:layout_width="28dp"
            android:layout_height="28dp">

            <ImageView
                android:id="@+id/tailzu_row_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/tailzu_widget_avatar" />

            <ImageView
                android:id="@+id/tailzu_row_ring"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/tailzu_widget_avatar_ring"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/tailzu_row_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/tailzu_widget_mark" />

            <TextView
                android:id="@+id/tailzu_row_initial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/tailzu_widget_ink"
                android:textSize="12dp"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/tailzu_row_words"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tailzu_row_who"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:textColor="@color/tailzu_widget_ink"
                        android:textSize="13dp" />

                    <TextView
                        android:id="@+id/tailzu_row_tag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:maxLines="1"
                        android:textColor="@color/tailzu_widget_meta"
                        android:textSize="12dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tailzu_row_when"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="end"
                        android:maxLines="1"
                        android:textColor="@color/tailzu_widget_meta"
                        android:textSize="11dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tailzu_row_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/tailzu_widget_ink"
                    android:textSize="13dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tailzu_row_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/tailzu_widget_meta"
                android:textSize="12dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/tailzu_row_buttons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:visibility="gone">

            <FrameLayout
                android:id="@+id/tailzu_row_b0"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginEnd="6dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/tailzu_row_b0_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/tailzu_widget_pill" />

                <ImageView
                    android:id="@+id/tailzu_row_b0_ring"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/tailzu_widget_pill_ring" />

                <TextView
                    android:id="@+id/tailzu_row_b0_text"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/tailzu_widget_ink"
                    android:textSize="12dp" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/tailzu_row_b1"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginEnd="6dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/tailzu_row_b1_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/tailzu_widget_pill" />

                <ImageView
                    android:id="@+id/tailzu_row_b1_ring"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/tailzu_widget_pill_ring" />

                <TextView
                    android:id="@+id/tailzu_row_b1_text"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/tailzu_widget_ink"
                    android:textSize="12dp" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/tailzu_row_b2"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginEnd="6dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/tailzu_row_b2_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/tailzu_widget_pill" />

                <ImageView
                    android:id="@+id/tailzu_row_b2_ring"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/tailzu_widget_pill_ring" />

                <TextView
                    android:id="@+id/tailzu_row_b2_text"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/tailzu_widget_ink"
                    android:textSize="12dp" />
            </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
