<?xml version="1.0" encoding="utf-8"?>
<!--
  A quick-access widget (TailzuQuickWidgets.kt): From your people, Needs you.
  The card, tinted at run time as the Month's is (the theme's own before that);
  the header (the mark, the app icon's bot, and the title); a column the rows
  are added to (tailzu_widget_quick_row, one per row the height has room for,
  hairlines between them); and the empty state with its button. Every colour
  and word is set at run time from what the app wrote; the ones here are the
  theme's, for the moment before the first draw.

  The root carries @android:id/background: Android 12+ rounds the widget's
  corners on it and animates a tap from it. A tap there opens the section.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/tailzu_quick_ground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/tailzu_widget_ground" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/tailzu_quick_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/tailzu_widget_mark" />

            <TextView
                android:id="@+id/tailzu_quick_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/tailzu_widget_ink"
                android:textSize="13dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tailzu_quick_rows"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/tailzu_quick_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="bottom|start"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tailzu_quick_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:textColor="@color/tailzu_widget_ink"
                android:textSize="15dp" />

            <TextView
                android:id="@+id/tailzu_quick_empty_body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp"
                android:maxLines="3"
                android:textColor="@color/tailzu_widget_meta"
                android:textSize="13dp" />

            <FrameLayout
                android:id="@+id/tailzu_quick_empty_cta"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginTop="10dp">

                <ImageView
                    android:id="@+id/tailzu_quick_empty_cta_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/tailzu_widget_pill" />

                <ImageView
                    android:id="@+id/tailzu_quick_empty_cta_ring"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/tailzu_widget_pill_ring" />

                <TextView
                    android:id="@+id/tailzu_quick_empty_cta_text"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="@color/tailzu_widget_ground"
                    android:textSize="13dp" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
