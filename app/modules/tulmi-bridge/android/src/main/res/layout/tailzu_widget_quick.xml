<?xml version="1.0" encoding="utf-8"?>
<!--
  A quick-access widget (TailzuQuickWidgets.kt): From your people, Needs you.
  The ground, tinted at run time as the Month's is; the header (the section's
  drawable and title); a column the rows are added to (tailzu_widget_quick_row,
  one per row the height has room for); and the empty state with its button.
  Every colour and word is set at run time from what the app wrote.

  The root carries @android:id/background: Android 12+ rounds the widget's
  corners on it and animates a tap from it. A tap there opens the section.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/tailzu_quick_ground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/tailzu_widget_ground" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/tailzu_quick_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/tailzu_wi_bot" />

            <TextView
                android:id="@+id/tailzu_quick_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.03"
                android:maxLines="1"
                android:textColor="#85F3E2C6"
                android:textSize="11dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tailzu_quick_rows"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/tailzu_quick_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="bottom|start"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tailzu_quick_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:textColor="#F3E2C6"
                android:textSize="15dp" />

            <TextView
                android:id="@+id/tailzu_quick_empty_body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="3"
                android:textColor="#85F3E2C6"
                android:textSize="12dp" />

            <FrameLayout
                android:id="@+id/tailzu_quick_empty_cta"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginTop="8dp">

                <ImageView
                    android:id="@+id/tailzu_quick_empty_cta_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/tailzu_widget_pill" />

                <TextView
                    android:id="@+id/tailzu_quick_empty_cta_text"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="#0F0D0B"
                    android:textSize="12dp" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
