<?xml version="1.0" encoding="utf-8"?>
<!--
  THE X0 WIDGET (TailzuX0Widget.kt), 4x4, all quiet: the X0 bot hanging on; the greeting, the day's line, the week's beads;
  the bots as Home's tiles; Ask with the peek-bot key.

  Generated with the other tailzu_x0_* layouts from one spec (android/x0-layouts.py), so a pill, a tile or a face is the same
  block everywhere. Every word, colour, face and tap is set at run time from the glance the app wrote (x0.glance); what is here
  is the theme's, for the moment before the first draw. RemoteViews-safe views only. The root carries @android:id/background:
  Android 12+ rounds the widget on it and animates a tap from it.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/tailzu_x0_ground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/tailzu_widget_ground" />

    <ImageView
        android:id="@+id/tailzu_x0_hang"
        android:layout_width="118dp"
        android:layout_height="70dp"
        android:layout_gravity="top|end"
        android:layout_marginEnd="24dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitStart"
        android:src="@drawable/tailzu_x0_hang" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tailzu_x0_hello"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="128dp"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/tailzu_widget_meta"
            android:textSize="14dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tailzu_x0_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="128dp"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:lineSpacingExtra="3dp"
            android:maxLines="3"
            android:textColor="@color/tailzu_widget_ink"
            android:textSize="26dp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/tailzu_x0_week"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/tailzu_x0_bead0"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginEnd="4dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/tailzu_x0_dot"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/tailzu_x0_bead1"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginEnd="4dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/tailzu_x0_dot"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/tailzu_x0_bead2"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginEnd="4dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/tailzu_x0_dot"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/tailzu_x0_bead3"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginEnd="4dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/tailzu_x0_dot"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/tailzu_x0_bead4"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginEnd="4dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/tailzu_x0_dot"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/tailzu_x0_bead_open"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/tailzu_x0_ring" />

            <TextView
                android:id="@+id/tailzu_x0_week_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/tailzu_widget_meta"
                android:textSize="12.5dp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/tailzu_x0_tiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/tailzu_x0_tiles_row1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/tailzu_x0_tile0"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:visibility="invisible">

                    <ImageView
                        android:id="@+id/tailzu_x0_tile0_bg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:src="@drawable/tailzu_x0_tile" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingEnd="10dp"
                        android:paddingStart="12dp">

                        <ImageView
                            android:id="@+id/tailzu_x0_tile0_face"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            android:src="@drawable/tailzu_x0_head_tailzu" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tailzu_x0_tile0_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="sans-serif-medium"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:textColor="@color/tailzu_widget_ink"
                                android:textSize="13.5dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/tailzu_x0_tile0_dot"
                                    android:layout_width="6dp"
                                    android:layout_height="6dp"
                                    android:layout_marginEnd="4dp"
                                    android:contentDescription="@null"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/tailzu_x0_dot"
                                    android:visibility="gone" />

                                <TextView
                                    android:id="@+id/tailzu_x0_tile0_line"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:ellipsize="end"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    android:textColor="@color/tailzu_widget_meta"
                                    android:textSize="11.5dp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>

                <FrameLayout
                    android:layout_width="8dp"
                    android:layout_height="1dp" />

                <FrameLayout
                    android:id="@+id/tailzu_x0_tile1"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:visibility="invisible">

                    <ImageView
                        android:id="@+id/tailzu_x0_tile1_bg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:src="@drawable/tailzu_x0_tile" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingEnd="10dp"
                        android:paddingStart="12dp">

                        <ImageView
                            android:id="@+id/tailzu_x0_tile1_face"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            android:src="@drawable/tailzu_x0_head_tailzu" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tailzu_x0_tile1_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="sans-serif-medium"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:textColor="@color/tailzu_widget_ink"
                                android:textSize="13.5dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/tailzu_x0_tile1_dot"
                                    android:layout_width="6dp"
                                    android:layout_height="6dp"
                                    android:layout_marginEnd="4dp"
                                    android:contentDescription="@null"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/tailzu_x0_dot"
                                    android:visibility="gone" />

                                <TextView
                                    android:id="@+id/tailzu_x0_tile1_line"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:ellipsize="end"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    android:textColor="@color/tailzu_widget_meta"
                                    android:textSize="11.5dp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tailzu_x0_tiles_row2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/tailzu_x0_tile2"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:visibility="invisible">

                    <ImageView
                        android:id="@+id/tailzu_x0_tile2_bg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:src="@drawable/tailzu_x0_tile" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingEnd="10dp"
                        android:paddingStart="12dp">

                        <ImageView
                            android:id="@+id/tailzu_x0_tile2_face"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            android:src="@drawable/tailzu_x0_head_tailzu" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tailzu_x0_tile2_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="sans-serif-medium"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:textColor="@color/tailzu_widget_ink"
                                android:textSize="13.5dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/tailzu_x0_tile2_dot"
                                    android:layout_width="6dp"
                                    android:layout_height="6dp"
                                    android:layout_marginEnd="4dp"
                                    android:contentDescription="@null"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/tailzu_x0_dot"
                                    android:visibility="gone" />

                                <TextView
                                    android:id="@+id/tailzu_x0_tile2_line"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:ellipsize="end"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    android:textColor="@color/tailzu_widget_meta"
                                    android:textSize="11.5dp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>

                <FrameLayout
                    android:layout_width="8dp"
                    android:layout_height="1dp" />

                <FrameLayout
                    android:id="@+id/tailzu_x0_tile3"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:visibility="invisible">

                    <ImageView
                        android:id="@+id/tailzu_x0_tile3_bg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:src="@drawable/tailzu_x0_tile" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingEnd="10dp"
                        android:paddingStart="12dp">

                        <ImageView
                            android:id="@+id/tailzu_x0_tile3_face"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            android:src="@drawable/tailzu_x0_head_tailzu" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tailzu_x0_tile3_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="sans-serif-medium"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:textColor="@color/tailzu_widget_ink"
                                android:textSize="13.5dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/tailzu_x0_tile3_dot"
                                    android:layout_width="6dp"
                                    android:layout_height="6dp"
                                    android:layout_marginEnd="4dp"
                                    android:contentDescription="@null"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/tailzu_x0_dot"
                                    android:visibility="gone" />

                                <TextView
                                    android:id="@+id/tailzu_x0_tile3_line"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:ellipsize="end"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    android:textColor="@color/tailzu_widget_meta"
                                    android:textSize="11.5dp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/tailzu_x0_ask"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp">

            <ImageView
                android:id="@+id/tailzu_x0_ask_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/tailzu_widget_pill" />

            <ImageView
                android:id="@+id/tailzu_x0_ask_ring"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/tailzu_widget_pill_ring" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingEnd="4dp"
                android:paddingStart="18dp">

                <TextView
                    android:id="@+id/tailzu_x0_ask_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/tailzu_x0_ask"
                    android:textColor="@color/tailzu_widget_meta"
                    android:textSize="15dp" />

                <ImageView
                    android:id="@+id/tailzu_x0_ask_key"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/tailzu_x0_peek" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
