<?xml version="1.0" encoding="utf-8"?>
<!--
  THE X0 WIDGET (TailzuX0Widget.kt), 4x2, bots working: the job's bot, task, bot and step; minutes so far; the stage bar with
  the stages' names; the others at work, their faces and what the first is doing.

  Generated with the other tailzu_x0_* layouts from one spec (android/x0-layouts.py), so a pill, a tile or a face is the same
  block everywhere. Every word, colour, face and tap is set at run time from the glance the app wrote (x0.glance); what is here
  is the theme's, for the moment before the first draw. RemoteViews-safe views only. The root carries @android:id/background:
  Android 12+ rounds the widget on it and animates a tap from it.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/tailzu_x0_ground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/tailzu_widget_ground" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/tailzu_x0_face"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/tailzu_x0_head_tailzu" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tailzu_x0_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/tailzu_widget_ink"
                    android:textSize="20dp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tailzu_x0_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/tailzu_widget_meta"
                    android:textSize="13dp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/tailzu_x0_chip"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginStart="8dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/tailzu_x0_chip_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/tailzu_widget_pill" />

                <TextView
                    android:id="@+id/tailzu_x0_chip_text"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:paddingEnd="10dp"
                    android:paddingStart="10dp"
                    android:textColor="@color/tailzu_widget_ink"
                    android:textSize="12.5dp" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tailzu_x0_track"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/tailzu_x0_bar"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/tailzu_widget_pill" />

            <LinearLayout
                android:id="@+id/tailzu_x0_stages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tailzu_x0_stage0"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="none"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/tailzu_widget_dim"
                    android:textSize="10.5dp" />

                <TextView
                    android:id="@+id/tailzu_x0_stage1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="none"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/tailzu_widget_dim"
                    android:textSize="10.5dp" />

                <TextView
                    android:id="@+id/tailzu_x0_stage2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="none"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/tailzu_widget_dim"
                    android:textSize="10.5dp" />

                <TextView
                    android:id="@+id/tailzu_x0_stage3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="none"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/tailzu_widget_dim"
                    android:textSize="10.5dp" />

                <TextView
                    android:id="@+id/tailzu_x0_stage4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="none"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/tailzu_widget_dim"
                    android:textSize="10.5dp" />

                <TextView
                    android:id="@+id/tailzu_x0_stage5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="none"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/tailzu_widget_dim"
                    android:textSize="10.5dp" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/tailzu_x0_crew"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <FrameLayout
                        android:id="@+id/tailzu_x0_crew0"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_marginStart="0dp"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/tailzu_x0_crew0_disc"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:scaleType="fitXY"
                            android:src="@drawable/tailzu_x0_dot" />

                        <ImageView
                            android:id="@+id/tailzu_x0_crew0_face"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            android:src="@drawable/tailzu_x0_head_tailzu" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/tailzu_x0_crew1"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_marginStart="18dp"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/tailzu_x0_crew1_disc"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:scaleType="fitXY"
                            android:src="@drawable/tailzu_x0_dot" />

                        <ImageView
                            android:id="@+id/tailzu_x0_crew1_face"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            android:src="@drawable/tailzu_x0_head_tailzu" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/tailzu_x0_crew2"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_marginStart="36dp"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/tailzu_x0_crew2_disc"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:scaleType="fitXY"
                            android:src="@drawable/tailzu_x0_dot" />

                        <ImageView
                            android:id="@+id/tailzu_x0_crew2_face"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            android:src="@drawable/tailzu_x0_head_tailzu" />
                    </FrameLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/tailzu_x0_crew_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/tailzu_widget_ink"
                    android:textSize="12.5dp" />

                <TextView
                    android:id="@+id/tailzu_x0_crew_line"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/tailzu_widget_meta"
                    android:textSize="12.5dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tailzu_x0_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/tailzu_widget_meta"
                android:textSize="12.5dp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
