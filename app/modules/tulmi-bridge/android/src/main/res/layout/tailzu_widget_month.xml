<?xml version="1.0" encoding="utf-8"?>
<!--
  The Month on the home screen (TailzuMonthWidget.kt). The card, tinted at run
  time to the server's ground (the theme's own before that); the face, a bitmap
  of the number, its label and the line drawn at the widget's size; and the
  mark, the app icon's bot: small at the top when there is a month to show (on
  a card tall enough for both), large in the middle when there is nothing yet.
  The mark is a themed drawable (on a small white disc at night), never tinted.

  As placed, before the first draw, the card shows the mark alone.

  The root carries @android:id/background because that is the view Android 12+
  launchers round the widget's corners on and animate a tap from. It is also
  what the tap is set on.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/tailzu_month_ground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/tailzu_widget_ground" />

    <ImageView
        android:id="@+id/tailzu_month_face"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter" />

    <ImageView
        android:id="@+id/tailzu_month_mark"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="14dp"
        android:layout_marginTop="14dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:src="@drawable/tailzu_widget_mark"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/tailzu_month_mark_big"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:src="@drawable/tailzu_widget_mark" />
</FrameLayout>
