<?xml version="1.0" encoding="utf-8"?>
<!--
  What the widget picker shows on Android 12+ before the widget is placed: one
  sample row in the default ink. Fixed, because the picker cannot read what
  the app wrote.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tailzu_widget_ground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/tailzu_widget_people_label"
            android:textColor="#85F3E2C6"
            android:textSize="11dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/tailzu_widget_people_preview_who"
                android:textColor="#F3E2C6"
                android:textSize="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tailzu_widget_people_preview_text"
                android:textColor="#DBF3E2C6"
                android:textSize="12dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
