<?xml version="1.0" encoding="utf-8"?>
<!--
  The widgets' words that the picker shows before the app has run, so they
  cannot come from the server, and the X0 widget's fallbacks for the words its
  glance brings (the glance's `words`, the server's knobs in en and Hinglish).
-->
<resources>
    <!--
      X0 (TailzuX0Widget.kt): its picker name and description, the words it
      falls back on when the glance has none (each the contract's own,
      docs/widget-glance-v2.md in the backend: needsYou, ready, ask, brand,
      youDecide, working, step, minIn, seePr, done; and min, pr and the answer's
      states, which a glance may add), and its picker preview's sample: Code bot
      building the cart fix, step 3 of 5, while Travel bot finds a hotel.
    -->
    <string name="tailzu_x0_label" translatable="false">X0</string>
    <string name="tailzu_x0_description">Your bots at a glance: what needs you, what they\'re doing, and Ask.</string>
    <string name="tailzu_x0_needs_you">Needs you</string>
    <string name="tailzu_x0_ready">Ready</string>
    <string name="tailzu_x0_ask">Ask any bot…</string>
    <string name="tailzu_x0_you_decide">You decide</string>
    <string name="tailzu_x0_working">{n} working</string>
    <string name="tailzu_x0_step">Step {stage} of {of}</string>
    <string name="tailzu_x0_min_in">{n} min in</string>
    <string name="tailzu_x0_min">{n} min</string>
    <string name="tailzu_x0_pr">PR #{n}</string>
    <string name="tailzu_x0_see_pr">See the PR</string>
    <string name="tailzu_x0_done">Done</string>
    <string name="tailzu_x0_sending">Sending…</string>
    <string name="tailzu_x0_gone">Already answered</string>
    <string name="tailzu_x0_failed">Open X0 to finish</string>
    <!-- Before the app has written a glance (never opened, or signed out). -->
    <string name="tailzu_x0_empty">Your bots, at a glance.</string>
    <string name="tailzu_x0_preview_task">Fixing cart</string>
    <string name="tailzu_x0_preview_sub">Code bot · Build, step 3 of 5</string>
    <string name="tailzu_x0_preview_min">52 min</string>
    <string name="tailzu_x0_preview_stage1">Understand</string>
    <string name="tailzu_x0_preview_stage2">Plan</string>
    <string name="tailzu_x0_preview_stage3">Build</string>
    <string name="tailzu_x0_preview_stage4">Check</string>
    <string name="tailzu_x0_preview_stage5">Ship</string>
    <string name="tailzu_x0_preview_crew">Travel bot</string>
    <string name="tailzu_x0_preview_crew_line">finding a hotel in Goa</string>

    <!--
      From your people (TailzuQuickWidgets.kt): its picker name and
      description, and what it shows before the app has written any rows
      (never opened, or signed out). Everything else it draws is the
      server's (GET /v1/widgets/now: widgets.* in the backend).
    -->
    <string name="tailzu_widget_people_label">From your people</string>
    <string name="tailzu_widget_people_description">The latest from family and friends.</string>
    <string name="tailzu_widget_people_empty_title">Your people, here</string>
    <string name="tailzu_widget_people_empty_body">Make a space for family and friends.</string>
    <string name="tailzu_widget_people_empty_cta">Make a space</string>
    <!-- The picker's preview: sample rows, worded as the server words them. -->
    <string name="tailzu_widget_people_preview_initial" translatable="false">R</string>
    <string name="tailzu_widget_people_preview_who" translatable="false">Riya</string>
    <string name="tailzu_widget_people_preview_tag">shared</string>
    <string name="tailzu_widget_people_preview_when" translatable="false">2m</string>
    <string name="tailzu_widget_people_preview_text">Weekend plan</string>
    <string name="tailzu_widget_people_preview2_initial" translatable="false">S</string>
    <string name="tailzu_widget_people_preview2_who" translatable="false">Sam</string>
    <string name="tailzu_widget_people_preview2_when" translatable="false">1h</string>
    <string name="tailzu_widget_people_preview2_text">Running late, start without me</string>

    <!--
      X0 BOARD (TailzuX0Board.kt): the spare kind whose contents its owner picks.
      These words are compiled in and a shipped widget kind can never be
      removed, so every line has to stay true in every state the app is ever
      in: before sign-in, while the look switch is off, and after new boards
      arrive in the catalog. So the description promises only what the bundled
      default board always draws (what needs you, who is working) plus the
      choice the configure screen always offers. It deliberately does not
      repeat X0's own line.
    -->
    <string name="tailzu_x0_board_label" translatable="false">X0 Board</string>
    <string name="tailzu_x0_board_description">A board you choose. It starts with what needs you and who\'s working.</string>
    <!-- The configure screen, reached from the launcher's reconfigure; placing the widget never opens it. -->
    <string name="tailzu_x0_board_choose">Choose a board</string>
    <!-- The compiled default row, which is in the list before any catalog has arrived. -->
    <string name="tailzu_x0_board_default">Overview</string>

    <!--
      "Bots at work" (TailzuBotsUpdate.kt): the ongoing notice while a bot
      works. Its own channel, so it can be turned off on its own without
      silencing anything else, and named for what it shows rather than for the
      app.
    -->
    <string name="tailzu_bots_channel">Bots at work</string>
    <string name="tailzu_bots_channel_about">What a bot is doing, while it does it. No sound.</string>
</resources>
