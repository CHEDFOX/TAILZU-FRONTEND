<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!--
    The ongoing "Bots at work" notice (TailzuBotsUpdate.kt) asks Android 16 to
    promote it to a Live Update with a status-bar chip. POST_PROMOTED_NOTIFICATIONS
    is a NORMAL permission: it is granted at install, nothing is asked of the
    person, and people can still turn the notice off per app. POST_NOTIFICATIONS
    (the runtime one, which IS asked) is already declared by the app itself.
    On Android 15 and below this permission does not exist and is ignored; the
    notice is then an ordinary ongoing progress notification, which is the whole
    of what those versions offer.
    It is declared here, in this module's own manifest, because the notice is this
    module's feature. It comes out in the same commit as liveUpdate if that item
    is cut (OWNERSHIP.md, the cut rule).
  -->
  <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

  <!--
    WHAT THIS APP MAY SEE OF THE OTHER APPS ON THE PHONE. From Android 11 an app
    is shown only the apps it declares an interest in, and an undeclared scheme
    makes canOpenURL say false and resolveActivity return nothing — so the app
    reports "no UPI app" on a phone that has four, and a tel: or mailto: link
    looks dead before it is even tried.

    One entry per scheme the app actually opens, and nothing wider: no
    QUERY_ALL_PACKAGES (which Play treats as a last resort and reviews), and no
    package names. `upi` is the pay hand-off (the iPhone's half is
    LSApplicationQueriesSchemes in app.config.ts); tel, sms and mailto are the
    links a plan item or an invite can carry; https is the browser, for the
    policy, the stores and a bot's links.

    It is declared here, in this module's own manifest, because this module is
    where the app's own opening goes through (TailzuQuick.openIntent). It is
    merged into the app's manifest with the library.
  -->
  <queries>
    <intent>
      <action android:name="android.intent.action.VIEW" />
      <data android:scheme="upi" />
    </intent>
    <intent>
      <action android:name="android.intent.action.VIEW" />
      <data android:scheme="tel" />
    </intent>
    <intent>
      <action android:name="android.intent.action.VIEW" />
      <data android:scheme="sms" />
    </intent>
    <intent>
      <action android:name="android.intent.action.VIEW" />
      <data android:scheme="mailto" />
    </intent>
    <intent>
      <action android:name="android.intent.action.VIEW" />
      <data android:scheme="https" />
    </intent>
  </queries>

  <application>
    <!--
      X0, the home-screen widget (TailzuX0Widget.kt): one entry in the picker,
      resizable from 2x2 to 4x4, leading with what matters now. Merged into the
      app's manifest with this library, so it runs in the app's own process and
      reads the glance setWidgetGlance wrote to the app's SharedPreferences.
      Not exported: only the system delivers widget updates (and this app's own
      alarm its redraw while a job runs), and both reach a receiver that is not.
      (The Month and Needs you widgets were retired for it.)
    -->
    <receiver
        android:name="expo.modules.tulmibridge.TailzuX0Widget"
        android:exported="false"
        android:label="@string/tailzu_x0_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
          android:name="android.appwidget.provider"
          android:resource="@xml/tailzu_x0_info" />
    </receiver>

    <!--
      X0 Board (TailzuX0Board.kt): the spare kind whose contents its owner
      picks, so a new board is a catalog change and not another store release.
      Same rules as X0 — the app's own process, not exported, only the system
      and this app's own alarms reach it. A shipped widget kind can never be
      removed, which is why this entry and its words (H6) are the way they are.
    -->
    <receiver
        android:name="expo.modules.tulmibridge.TailzuX0BoardWidget"
        android:exported="false"
        android:label="@string/tailzu_x0_board_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
          android:name="android.appwidget.provider"
          android:resource="@xml/tailzu_x0_board_info" />
    </receiver>

    <!--
      "Choose a board". Exported, because the LAUNCHER starts it for its own
      reconfigure gesture, and it is the one activity here that is. It is safe
      to start from anywhere: it reads only the widget id the system hands it,
      writes only this app's own pick for that widget, and shows nothing the
      home screen does not already show.
    -->
    <activity
        android:name="expo.modules.tulmibridge.TailzuX0BoardConfigure"
        android:exported="true"
        android:excludeFromRecents="true"
        android:label="@string/tailzu_x0_board_choose">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
      </intent-filter>
    </activity>

    <!--
      From your people (TailzuQuickWidgets.kt). Same rules: in the app's
      process, reading what setWidgetNow wrote, not exported.
    -->
    <receiver
        android:name="expo.modules.tulmibridge.TailzuPeopleWidget"
        android:exported="false"
        android:label="@string/tailzu_widget_people_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
          android:name="android.appwidget.provider"
          android:resource="@xml/tailzu_widget_people_info" />
    </receiver>
    <!--
      A widget's button that answers on the spot (X0's answers, a row's
      button): only the widgets' own PendingIntents reach it (not exported, no
      intent filter). It posts with the widgets' narrow token, never the
      session's.
    -->
    <receiver
        android:name="expo.modules.tulmibridge.TailzuWidgetActReceiver"
        android:exported="false" />
  </application>
</manifest>
